---
import { services } from '../data/platform';
import CopyLink from './react/CopyLink';
---

<section id="servicios" class="mb-[47px] max-sm:mb-9">
  <div class="mb-[23px] flex items-end justify-between gap-5 max-sm:mb-[18px] max-sm:block">
    <div>
      <div class="font-mono text-[10px] font-semibold tracking-[1.5px] text-brand max-sm:text-[8px]">
        04 / SERVICIOS
      </div>
      <h2 class="mb-0 mt-[7px] text-[26px] font-semibold tracking-[-0.8px] max-sm:text-[24px]">Servicios publicados</h2>
    </div>
    <p class="m-0 text-right text-[11px] text-muted max-sm:mt-2 max-sm:text-left">Accesos HTTPS servidos por Nginx.</p>
  </div>

  {
    services.map((s) => (
      <div class="flex items-center gap-[27px] border-b border-line py-[23px] max-lg:gap-[15px] max-sm:grid max-sm:grid-cols-[1fr_auto] max-sm:gap-3">
        <div class="whitespace-nowrap text-[10px] max-sm:col-span-2">
          <span class="status-dot"></span>
          <strong>{s.tag}</strong>
        </div>
        <div>
          <h3 class="mb-[3px] text-[12px] font-semibold">
            <a class="hover:text-brand" href={s.href}>{s.title}</a>
          </h3>
          <p class="m-0 text-[10px] text-muted max-sm:text-[11px]">{s.body}</p>
        </div>
        <div class="ml-auto flex items-center gap-2 max-sm:col-span-2">
          <CopyLink client:visible url={s.href} />
          <a
            class="rounded bg-[#e1efe4] px-[7px] py-1 font-mono text-[8px] text-[#087055] transition-colors hover:bg-[#d3e7da]"
            href={s.href}
          >
            {s.cta.toUpperCase()} ↗
          </a>
        </div>
      </div>
    ))
  }
</section>
