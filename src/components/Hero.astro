<section id="resumen" class="relative overflow-hidden py-[57px] pb-[43px] max-sm:py-8">
  <div class="flex items-center gap-2 font-mono text-[10px] font-semibold tracking-[1.5px] text-brand max-sm:text-[8px]">
    <span class="h-1.5 w-1.5 rounded-full bg-brand"></span> PLANTILLA · DOCUMENTACIÓN
  </div>

  <h1
    class="relative z-[1] mb-[18px] mt-[23px] font-[650] text-[clamp(32px,3.6vw,53px)] leading-[1.13] tracking-[-2px] max-sm:text-[36px] max-sm:tracking-[-1.5px]"
  >
    Todo empieza con<br />una buena estructura<span class="text-brand">.</span>
  </h1>

  <p class="text-[14px] leading-[1.85] text-muted max-sm:text-[12px]">
    Documentación por completar.<br class="max-sm:hidden" />
    Cada sección se rellenará a medida que se configure el servidor.
  </p>

  <div class="mt-[26px] flex items-center gap-[25px] max-sm:gap-5">
    <a
      href="#arquitectura"
      class="inline-flex items-center gap-6 rounded-[5px] bg-brand px-[17px] py-[11px] text-[11px] font-[650] text-white transition-colors hover:bg-[#06644f] max-sm:gap-4 max-sm:px-[13px] max-sm:py-2.5 max-sm:text-[10px]"
    >
      Explorar estructura <span aria-hidden="true">↗</span>
    </a>
    <a href="#actual" class="text-[11px] font-semibold max-sm:text-[10px]">
      Ver estado actual <span class="ml-3" aria-hidden="true">↓</span>
    </a>
  </div>

  <div class="hero-mark" aria-hidden="true">
    <div class="mark-top"></div>
    <div class="mark-mid"></div>
    <div class="mark-low"></div>
    <span>BUILD FROM A CLEAR FOUNDATION</span>
  </div>
</section>
