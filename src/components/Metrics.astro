---
import { metrics } from '../data/platform';
---

<div
  class="mb-[49px] grid grid-cols-4 rounded-[9px] border border-line bg-white py-[22px] max-lg:px-0 max-sm:mb-[35px] max-sm:grid-cols-2 max-sm:py-0"
  aria-label="Resumen actual"
>
  {
    metrics.map((m, i) => (
      <div
        class:list={[
          'border-r border-line px-6 max-lg:px-4 max-sm:px-[19px] max-sm:py-[17px]',
          i === metrics.length - 1 && 'border-r-0',
          'max-sm:border-b max-sm:border-line max-sm:[&:nth-child(2)]:border-r-0 max-sm:[&:nth-child(n+3)]:border-b-0',
        ]}
      >
        <span class="mb-2 block font-mono text-[9px] tracking-[1px] text-muted max-sm:text-[8px]">{m.label}</span>
        {m.value ? (
          <strong class="text-[27px] font-[550] leading-[1.3] tracking-[-1px]">
            {m.value} <small class="text-[10px] font-normal tracking-normal text-muted">{m.unit}</small>
          </strong>
        ) : (
          <strong class="flex min-h-[35px] items-center gap-3 text-[18px] font-[550] tracking-[-0.3px] max-sm:text-[17px]">
            {m.text} <span class={m.dot === 'tiny' ? 'tiny-dot' : 'status-dot'}></span>
          </strong>
        )}
      </div>
    ))
  }
</div>
