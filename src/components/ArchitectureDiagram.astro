---
import type { ArchitectureDiagram } from '../data/architecture';

interface Props {
  diagram: ArchitectureDiagram;
  eager?: boolean;
}
const { diagram, eager = false } = Astro.props;
const href = `/diagramas/archify/${diagram.id}.html`;
---

<section id={diagram.id} aria-labelledby={`${diagram.id}-title`}>
  <div class="mb-4 flex flex-wrap items-end justify-between gap-4">
    <div>
      <span class="font-mono text-[10px] font-semibold text-brand">{diagram.index} / ARCHIFY</span>
      <h2 id={`${diagram.id}-title`} class="mt-1 text-[24px] font-semibold tracking-[-0.6px]">{diagram.title}</h2>
      <p class="mt-1 max-w-[720px] text-[12px] leading-6 text-muted">{diagram.detail}</p>
    </div>
    <div class="flex flex-wrap gap-3 text-[11px] font-semibold">
      <a href={href} target="_blank" rel="noopener" class="rounded-md bg-brand px-4 py-2 text-white hover:bg-[#06644f]">Abrir diagrama completo ↗</a>
      <a href={href} download class="rounded-md border border-line bg-white px-4 py-2 hover:bg-sidebar">Descargar HTML</a>
    </div>
  </div>
  <iframe src={href} title={`Diagrama interactivo: ${diagram.title}`} loading={eager ? 'eager' : 'lazy'} class="h-[860px] w-full rounded-lg border border-line bg-white sm:h-[960px]" allow="clipboard-write; fullscreen" allowfullscreen></iframe>
  <p class="mt-3 text-[11px] leading-6 text-muted">Selecciona un componente para ver sus conexiones. El visor incluye búsqueda, zoom, temas claro/oscuro y exportación de imágenes. En pantallas pequeñas, abre el diagrama completo para disponer de más espacio.</p>
  {diagram.id === 'lrs' && <a href="#lrs-almacenamiento" class="mt-3 inline-block text-[12px] font-semibold text-brand hover:underline">Cómo se guardan los datos y se evitan conflictos de PostgreSQL →</a>}
</section>
